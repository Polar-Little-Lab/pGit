{
  "name": "pgit",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server.mjs",
    "test": "node --test test/*.test.mjs",
    "desktop": "electron .",
    "dist:mac": "electron-builder --mac zip dmg --arm64 --x64 --publish never",
    "predist:mac": "node scripts/build-icons.cjs",
    "test:ui": "node test/ui.mjs && node test/ui-tabs.mjs && node test/ui-workflow.mjs && node test/ui-language.mjs && node test/ui-diff-editor.mjs"
  },
  "main": "desktop/main.cjs",
  "description": "Polar Frost local Git client",
  "author": "Polar Little Lab",
  "devDependencies": {
    "electron": "40.0.0",
    "electron-builder": "26.0.12",
    "playwright": "1.58.2"
  },
  "build": {
    "appId": "dev.polar.pgit",
    "productName": "pGit",
    "files": [
      "desktop/**/*",
      "git.mjs",
      "server.mjs",
      "package.json",
      "operations.mjs",
      "advanced.mjs",
      "scripts/sequence-editor.cjs",
      "providers.mjs",
      "public/*.js",
      "public/*.css",
      "public/*.svg",
      "comparison.mjs",
      "public/*.html"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "identity": null,
      "hardenedRuntime": false,
      "artifactName": "pGit-${version}-macos-${arch}.${ext}",
      "icon": "build/icon.png"
    },
    "directories": {
      "output": "dist"
    },
    "afterPack": "desktop/sign.cjs"
  }
}
