{
  "name": "pgit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server.mjs",
    "test": "node --test test/*.test.mjs",
    "desktop": "electron .",
    "dist:mac": "electron-builder --mac zip dmg --arm64 --x64 --publish never"
  },
  "main": "desktop/main.cjs",
  "description": "Polar Frost local Git client",
  "author": "Polar Little Lab",
  "devDependencies": {
    "electron": "40.0.0",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "dev.polar.pgit",
    "productName": "pGit",
    "files": [
      "desktop/**/*",
      "public/*",
      "git.mjs",
      "server.mjs",
      "package.json",
      "operations.mjs"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "identity": null,
      "hardenedRuntime": false,
      "artifactName": "pGit-${version}-macos-${arch}.${ext}"
    },
    "directories": {
      "output": "dist"
    },
    "afterPack": "desktop/sign.cjs"
  }
}
