{
  "name": "pgit",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server.mjs",
    "test": "node --test test/*.test.mjs",
    "desktop": "electron .",
    "dist:mac": "electron-builder --mac zip dmg --arm64 --x64 --publish never",
    "predist:mac": "node scripts/build-icons.cjs",
    "test:ui": "node test/run-ui-tests.mjs",
    "dist:win": "electron-builder --win nsis --x64 --publish never",
    "predist:win": "node scripts/build-icons.cjs",
    "test:desktop": "node test/desktop-smoke.mjs && node test/desktop-worktree-folder.mjs && node test/desktop-init-folder.mjs && node test/desktop-clone-folder.mjs"
  },
  "main": "desktop/main.cjs",
  "description": "Polar Frost local Git client",
  "author": "Polar Little Lab",
  "devDependencies": {
    "electron": "45.3.1",
    "electron-builder": "26.18.0",
    "playwright": "1.58.2"
  },
  "build": {
    "appId": "dev.polar.pgit",
    "productName": "pGit",
    "files": [
      "desktop/**/*",
      "docs/USER_GUIDE.md",
      "docs/GPT_HANDOFF.md",
      "docs/GPT_WEB_TASK_PROMPT.md",
      "docs/images/*.png",
      "git.mjs",
      "server.mjs",
      "package.json",
      "operations.mjs",
      "clone-progress.mjs",
      "merge-preview.mjs",
      "refresh.mjs",
      "multi-commit.mjs",
      "advanced.mjs",
      "scripts/sequence-editor.cjs",
      "providers.mjs",
      "public/*.js",
      "public/*.css",
      "public/*.svg",
      "comparison.mjs",
      "public/*.html",
      "public/*.png",
      "history-edits.mjs",
      "scripts/reword-commit.cjs",
      "provider-review.mjs",
      "provider-remotes.mjs",
      "path-utils.cjs",
      "project-groups.cjs",
      "group-icon-catalog.cjs",
      "public/group-icons/*.svg",
      "public/group-icons/*.png",
      "docs/GROUP_ICON_SOURCES.md",
      "docs/GROUP_ICON_UX.md",
      "git-runtime.mjs",
      "scripts/git-noop.cjs",
      "scripts/git-no-prompt.cjs"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "identity": null,
      "hardenedRuntime": false,
      "artifactName": "pGit-${version}-macos-${arch}.${ext}",
      "icon": "build/icon.png"
    },
    "directories": {
      "output": "dist"
    },
    "afterPack": "desktop/sign.cjs",
    "asarUnpack": [
      "scripts/*.cjs"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "pGit-${version}-windows-${arch}-setup.${ext}",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "include": "desktop/installer.nsh"
    }
  }
}
